---
/**
 * CategoryProductCard - Product card for category archive pages
 * Matches WordPress WooCommerce styling from staging.hercules-merchandise.de
 */
import 'swiper/css';
import WishlistButton from './WishlistButton.tsx';

interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    price: string;
    regular_price?: string;
    on_sale?: boolean;
    images: Array<{ src: string; alt: string }>;
    categories?: Array<{ slug: string; name: string }>;
    variations?: Array<{
      conditional_prices?: Array<{ qty: number; price: number }>;
    }>;
    // Badge fields from custom meta
    made_in_europe?: boolean;
    green_product?: boolean;
    // USP features for card display
    card_features?: string[];
    // Number of images cached in KV (from Worker sync)
    cached_image_count?: number;
  };
}

const { product } = Astro.props;

const WORKER_URL = 'https://hercules-product-sync.gilles-86d.workers.dev';

// Get gallery images from Worker KV cache (no WordPress access at runtime)
// Use cached_image_count from product data to know exactly how many images are available
// Fall back to images array length with a max of 10 if cached_image_count not set
const imageCount = product.cached_image_count ?? Math.min(product.images?.length || 0, 10);
const galleryImages = (product.images || []).slice(0, imageCount).map((img, index) => {
  // Worker URL format: /image/{slug} for index 0, /image/{slug}/{index} for gallery
  const mainSrc = index === 0
    ? `${WORKER_URL}/image/${product.slug}`
    : `${WORKER_URL}/image/${product.slug}/${index}`;
  return {
    thumb: mainSrc, // Use same cached image for thumbnail
    main: mainSrc,
    alt: img.alt || product.name
  };
});

// Worker cached main image URL
const workerImageUrl = `${WORKER_URL}/image/${product.slug}`;

// Format price - just show the base price like WooCommerce does
let priceDisplay = '';
if (product.price) {
  const price = parseFloat(product.price);
  if (!isNaN(price)) {
    priceDisplay = `€ ${price.toFixed(2).replace('.', ',')}`;
  }
}

// Badge display based on custom meta fields (NOT categories)
const isMadeInEurope = product.made_in_europe === true;
const isSustainable = product.green_product === true;

// Card features (USP list)
const cardFeatures = product.card_features || [];
---

<li class="product">
  <!-- Wishlist Button - positioned top-right -->
  <div class="kd-wishlist-wrapper">
    <WishlistButton
      productId={product.id}
      productName={product.name}
      productSlug={product.slug}
      productPrice={priceDisplay}
      productThumbnail={workerImageUrl}
      size={18}
      client:idle
    />
  </div>

  <a href={`/produkte/${product.slug}`} class="woocommerce-LoopProduct-link">
    <!-- Badges - positioned top-left like WordPress -->
    {(isMadeInEurope || isSustainable) && (
      <div class="kd-archive-badges-wrapper">
        {isSustainable && (
          <img
            src="/images/badges/green-option.svg"
            alt="Umweltfreundliches Produkt-Siegel"
            class="kd-product-badge kd-badge-eco"
          />
        )}
        {isMadeInEurope && (
          <img
            src="/images/badges/made-in-europe.svg"
            alt="Siegel Hergestellt in Europa"
            class="kd-product-badge kd-badge-eu"
          />
        )}
      </div>
    )}

    <!-- Product Gallery -->
    <div class="kd-product-gallery">
      <!-- Main Image -->
      <div class="kd-main-image">
        <img
          src={workerImageUrl}
          alt={product.name}
          loading="lazy"
          class="kd-main-img"
          width="361"
          height="361"
        />
      </div>

      <!-- Thumbnail Carousel - Swiper, 4 visible, slide 1 at a time -->
      {galleryImages.length > 1 && (
        <div class="kd-thumbnails swiper-container">
          <div class="swiper-wrapper">
            {galleryImages.map((img, index) => (
              <div class="swiper-slide">
                <img
                  src={img.thumb}
                  alt={img.alt}
                  loading="lazy"
                  class="kd-thumb"
                  width="83"
                  height="83"
                  data-full={img.main}
                  onerror={`this.parentElement.style.display='none'`}
                />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <h2 class="woocommerce-loop-product__title">{product.name}</h2>

    <!-- Card Features (USP list with checkmarks) -->
    {cardFeatures.length > 0 && (
      <ul class="kd-single-card-qty-list">
        {cardFeatures.map(feature => (
          <li>{feature}</li>
        ))}
      </ul>
    )}
  </a>
  <a href={`/produkte/${product.slug}`} class="button product_type_variable">
    Mehr erfahren
  </a>
</li>

<style>
  .product {
    list-style: none;
    text-align: center;
    border-style: solid;
    border-width: 1px;
    border-radius: 20px;
    padding: 20px 15px 20px 15px;
    background-color: #FFFFFF;
    border-color: #DCDCDC;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .woocommerce-LoopProduct-link {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-decoration: none;
    color: inherit;
    position: relative;
    min-width: 0;
  }

  /* Wishlist button - positioned top-right */
  .kd-wishlist-wrapper {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 15;
  }

  /* Badges - positioned top-left like WordPress */
  .kd-archive-badges-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    z-index: 10;
  }

  .kd-product-badge {
    display: block;
    width: 40px;
    height: auto;
  }

  .kd-badge-eco {
    width: 35px;
  }

  .kd-badge-eu {
    width: 40px;
  }

  /* Product Gallery */
  .kd-product-gallery {
    width: 100%;
    margin-bottom: 10px;
    min-width: 0;
  }

  .kd-main-image {
    width: 100%;
    margin-bottom: 8px;
  }

  .kd-main-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    object-fit: contain;
    aspect-ratio: 1/1;
  }

  /* Thumbnail carousel - Swiper */
  .kd-thumbnails {
    width: 100%;
    overflow: hidden;
    min-width: 0;
  }

  .kd-thumbnails .swiper-wrapper {
    display: flex;
  }

  .kd-thumbnails .swiper-slide {
    flex-shrink: 0;
    background: #F2F2F2;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kd-thumb {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: contain;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s, opacity 0.2s;
    opacity: 0.85;
    display: block;
  }

  .kd-thumb:hover,
  .kd-thumb.active {
    border-color: #469ADC;
    opacity: 1;
  }

  .woocommerce-loop-product__title {
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    font-weight: 500;
    text-transform: uppercase;
    color: #253461;
    padding: 0;
    margin: 10px 0 5px 0;
    line-height: 1.3;
    text-align: center;
  }

  /* Card features list with checkmarks */
  .kd-single-card-qty-list {
    list-style: none;
    padding: 0;
    margin: 0 0 10px 0;
    text-align: left;
  }

  .kd-single-card-qty-list li {
    position: relative;
    padding-left: 25px;
    margin-bottom: 8px;
    color: #626262;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    line-height: 1.3;
  }

  .kd-single-card-qty-list li::before {
    content: '✔';
    position: absolute;
    left: 0;
    top: 0;
    color: #469ADC;
    font-weight: 700;
  }

  .button {
    display: inline-block;
    padding: 12px 25px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
    text-align: center;
    background-color: #469ADC;
    color: #FFFFFF;
    border: 1px solid #469ADC;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.1s ease;
    margin-top: auto;
    align-self: center;
  }

  .button:hover {
    background-color: transparent;
    color: #469ADC;
    border-color: #469ADC;
  }

  /* Responsive adjustments */
  @media (max-width: 767px) {
    .product {
      padding: 15px 10px;
    }

    .woocommerce-loop-product__title {
      font-size: 16px;
    }

    .button {
      font-size: 11px;
      padding: 8px 12px;
    }
  }
</style>

<script>
  import Swiper from 'swiper';

  /**
   * Non-blocking gallery initialization
   * Uses requestIdleCallback to defer Swiper init and prevent forced reflows
   */
  function initGalleries() {
    // Initialize each thumbnail carousel with Swiper
    document.querySelectorAll('.kd-thumbnails.swiper-container').forEach((container, index) => {
      // Create unique class for this swiper instance
      container.classList.add(`kd-swiper-${index}`);

      // Initialize Swiper - 4 visible thumbnails, matching WordPress
      new Swiper(`.kd-swiper-${index}`, {
        slidesPerView: 4,
        spaceBetween: 10,
        slidesPerGroup: 1,
        watchSlidesProgress: true,
        loop: false
      });

      // Set first thumbnail as active
      const firstThumb = container.querySelector('.kd-thumb');
      if (firstThumb) firstThumb.classList.add('active');
    });

    // Thumbnail click to swap main image (prevent navigation)
    document.querySelectorAll('.kd-thumb').forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const gallery = thumb.closest('.kd-product-gallery');
        const mainImg = gallery?.querySelector('.kd-main-img') as HTMLImageElement;
        const fullSrc = thumb.dataset.full;
        const container = thumb.closest('.kd-thumbnails');

        if (mainImg && fullSrc) {
          mainImg.src = fullSrc;
          // Update active state
          container?.querySelectorAll('.kd-thumb').forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
        }
      });
    });
  }

  // Use requestIdleCallback for non-blocking initialization
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => initGalleries(), { timeout: 1000 });
  } else {
    // Fallback for browsers without requestIdleCallback
    window.addEventListener('load', () => setTimeout(initGalleries, 100));
  }
</script>
