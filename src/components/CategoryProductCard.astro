---
/**
 * CategoryProductCard - Product card for category archive pages
 * Matches WordPress WooCommerce styling from staging.hercules-merchandise.de
 */
import 'swiper/css';
import WishlistButton from './WishlistButton.tsx';

interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    price: string;
    regular_price?: string;
    on_sale?: boolean;
    images: Array<{ src: string; alt: string }>;
    categories?: Array<{ slug: string; name: string }>;
    variations?: Array<{
      conditional_prices?: Array<{ qty: number; price: number }>;
    }>;
    // Badge fields from custom meta
    made_in_europe?: boolean;
    green_product?: boolean;
    // USP features for card display
    card_features?: string[];
    // Number of images cached in KV (from Worker sync)
    cached_image_count?: number;
  };
  /** Product index in grid - used for fetchpriority (first 6 get high priority) */
  index?: number;
}

const { product, index = 0 } = Astro.props;

// First 3 products are above the fold on mobile (1 col) and tablet (2 col)
// These get eager loading to improve LCP
// Only the very first product gets fetchpriority="high" (actual LCP candidate)
const isAboveFold = index < 3;
const isLCPCandidate = index === 0;

const WORKER_URL = 'https://hercules-product-sync.gilles-86d.workers.dev';

// Get gallery images from Worker KV cache (no WordPress access at runtime)
// Use cached_image_count from product data to know exactly how many images are available
// Fall back to images array length with a max of 10 if cached_image_count not set
const imageCount = product.cached_image_count ?? Math.min(product.images?.length || 0, 10);
const galleryImages = (product.images || []).slice(0, imageCount).map((img, index) => {
  // Worker URL format: /image/{slug} for index 0, /image/{slug}/{index} for gallery
  const mainSrc = index === 0
    ? `${WORKER_URL}/image/${product.slug}`
    : `${WORKER_URL}/image/${product.slug}/${index}`;
  return {
    thumb: mainSrc, // Use same cached image for thumbnail
    main: mainSrc,
    alt: img.alt || product.name
  };
});

// Worker cached main image URL
const workerImageUrl = `${WORKER_URL}/image/${product.slug}`;

// Format price - just show the base price like WooCommerce does
let priceDisplay = '';
if (product.price) {
  const price = parseFloat(product.price);
  if (!isNaN(price)) {
    priceDisplay = `€ ${price.toFixed(2).replace('.', ',')}`;
  }
}

// Badge display based on custom meta fields (NOT categories)
const isMadeInEurope = product.made_in_europe === true;
const isSustainable = product.green_product === true;

// Card features (USP list)
const cardFeatures = product.card_features || [];
---

<li class="product">
  <!-- Wishlist Button - positioned top-right -->
  <div class="kd-wishlist-wrapper">
    <WishlistButton
      productId={product.id}
      productName={product.name}
      productSlug={product.slug}
      productPrice={priceDisplay}
      productThumbnail={workerImageUrl}
      size={18}
      client:idle
    />
  </div>

  <a href={`/produkte/${product.slug}`} class="woocommerce-LoopProduct-link">
    <!-- Badges - positioned top-left like WordPress -->
    {(isMadeInEurope || isSustainable) && (
      <div class="kd-archive-badges-wrapper">
        {isSustainable && (
          <img
            src="/images/badges/green-option.svg"
            alt="Umweltfreundliches Produkt-Siegel"
            class="kd-product-badge kd-badge-eco"
          />
        )}
        {isMadeInEurope && (
          <img
            src="/images/badges/made-in-europe.svg"
            alt="Siegel Hergestellt in Europa"
            class="kd-product-badge kd-badge-eu"
          />
        )}
      </div>
    )}

    <!-- Product Gallery -->
    <div class="kd-product-gallery">
      <!-- Main Image -->
      <div class="kd-main-image">
        <img
          src={workerImageUrl}
          alt={product.name}
          loading={isAboveFold ? "eager" : "lazy"}
          fetchpriority={isLCPCandidate ? "high" : "auto"}
          class="kd-main-img"
          width="361"
          height="361"
        />
      </div>

      <!-- Thumbnail Carousel - Deferred loading to improve LCP -->
      <!-- Gallery images are loaded via JS after page load to reduce initial requests -->
      {galleryImages.length > 1 && (
        <div
          class="kd-thumbnails swiper-container kd-gallery-deferred"
          data-gallery={JSON.stringify(galleryImages)}
          data-product-slug={product.slug}
        >
          <div class="swiper-wrapper">
            <!-- Placeholder slides - images will be injected via JS -->
            {galleryImages.slice(0, 4).map((_, idx) => (
              <div class="swiper-slide kd-thumb-placeholder">
                <div class="kd-thumb-skeleton"></div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <h2 class="woocommerce-loop-product__title">{product.name}</h2>

    <!-- Card Features (USP list with checkmarks) -->
    {cardFeatures.length > 0 && (
      <ul class="kd-single-card-qty-list">
        {cardFeatures.map(feature => (
          <li>{feature}</li>
        ))}
      </ul>
    )}
  </a>
  <a href={`/produkte/${product.slug}`} class="button product_type_variable">
    Mehr erfahren
  </a>
</li>

<style>
  .product {
    list-style: none;
    text-align: center;
    border-style: solid;
    border-width: 1px;
    border-radius: 20px;
    padding: 20px 15px 20px 15px;
    background-color: #FFFFFF;
    border-color: #DCDCDC;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .woocommerce-LoopProduct-link {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-decoration: none;
    color: inherit;
    position: relative;
    min-width: 0;
  }

  /* Wishlist button - positioned top-right */
  .kd-wishlist-wrapper {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 15;
  }

  /* Badges - positioned top-left like WordPress */
  .kd-archive-badges-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    z-index: 10;
  }

  .kd-product-badge {
    display: block;
    width: 40px;
    height: auto;
  }

  .kd-badge-eco {
    width: 35px;
  }

  .kd-badge-eu {
    width: 40px;
  }

  /* Product Gallery */
  .kd-product-gallery {
    width: 100%;
    margin-bottom: 10px;
    min-width: 0;
  }

  .kd-main-image {
    width: 100%;
    margin-bottom: 8px;
  }

  .kd-main-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    object-fit: contain;
    aspect-ratio: 1/1;
  }

  /* Thumbnail carousel - Swiper */
  .kd-thumbnails {
    width: 100%;
    overflow: hidden;
    min-width: 0;
  }

  .kd-thumbnails .swiper-wrapper {
    display: flex;
  }

  .kd-thumbnails .swiper-slide {
    flex-shrink: 0;
    background: #F2F2F2;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kd-thumb {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: contain;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s, opacity 0.2s;
    opacity: 0.85;
    display: block;
  }

  .kd-thumb:hover,
  .kd-thumb.active {
    border-color: #469ADC;
    opacity: 1;
  }

  /* Skeleton placeholders for deferred gallery loading - prevents CLS */
  .kd-thumb-placeholder {
    background: #F2F2F2;
    border-radius: 4px;
  }

  .kd-thumb-skeleton {
    width: 83px;
    height: 83px;
    background: linear-gradient(90deg, #F2F2F2 25%, #E8E8E8 50%, #F2F2F2 75%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite;
    border-radius: 4px;
  }

  @keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Hide skeleton when images are loaded */
  .kd-gallery-loaded .kd-thumb-placeholder {
    display: none;
  }

  .woocommerce-loop-product__title {
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    font-weight: 500;
    text-transform: uppercase;
    color: #253461;
    padding: 0;
    margin: 10px 0 5px 0;
    line-height: 1.3;
    text-align: center;
  }

  /* Card features list with checkmarks */
  .kd-single-card-qty-list {
    list-style: none;
    padding: 0;
    margin: 0 0 10px 0;
    text-align: left;
  }

  .kd-single-card-qty-list li {
    position: relative;
    padding-left: 25px;
    margin-bottom: 8px;
    color: #626262;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    line-height: 1.3;
  }

  .kd-single-card-qty-list li::before {
    content: '✔';
    position: absolute;
    left: 0;
    top: 0;
    color: #469ADC;
    font-weight: 700;
  }

  .button {
    display: inline-block;
    padding: 12px 25px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
    text-align: center;
    background-color: #469ADC;
    color: #FFFFFF;
    border: 1px solid #469ADC;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.1s ease;
    margin-top: auto;
    align-self: center;
  }

  .button:hover {
    background-color: transparent;
    color: #469ADC;
    border-color: #469ADC;
  }

  /* Responsive adjustments */
  @media (max-width: 767px) {
    .product {
      padding: 15px 10px;
    }

    .woocommerce-loop-product__title {
      font-size: 16px;
    }

    .button {
      font-size: 11px;
      padding: 8px 12px;
    }
  }
</style>

<script>
  /**
   * Deferred gallery loading using IntersectionObserver
   *
   * Gallery thumbnails are only loaded when:
   * 1. The product card enters the viewport (200px margin)
   * 2. This dramatically reduces initial image requests from 90+ to ~6-12
   *
   * Benefits:
   * - LCP improves because only main product images load initially
   * - CLS = 0 because skeleton placeholders reserve space
   * - User sees thumbnails when they scroll to view them
   * - Swiper is dynamically imported only when needed (reduces initial JS)
   */

  // Track which galleries have been initialized to avoid duplicates
  const initializedGalleries = new Set<string>();
  let swiperIndex = 0;
  let SwiperModule: any = null;

  async function loadGalleryImages(container: Element): Promise<void> {
    const galleryData = container.getAttribute('data-gallery');
    const productSlug = container.getAttribute('data-product-slug');

    if (!galleryData || !productSlug || initializedGalleries.has(productSlug)) {
      return;
    }

    initializedGalleries.add(productSlug);

    try {
      const images = JSON.parse(galleryData) as Array<{ thumb: string; main: string; alt: string }>;
      const wrapper = container.querySelector('.swiper-wrapper');

      if (!wrapper) return;

      // Clear placeholder slides
      wrapper.innerHTML = '';

      // Create actual image slides
      images.forEach((img, idx) => {
        const slide = document.createElement('div');
        slide.className = 'swiper-slide';

        const imgEl = document.createElement('img');
        imgEl.src = img.thumb;
        imgEl.alt = img.alt;
        imgEl.loading = 'lazy';
        imgEl.className = 'kd-thumb' + (idx === 0 ? ' active' : '');
        imgEl.width = 83;
        imgEl.height = 83;
        imgEl.dataset.full = img.main;
        imgEl.onerror = () => { slide.style.display = 'none'; };

        slide.appendChild(imgEl);
        wrapper.appendChild(slide);
      });

      // Mark as loaded and initialize Swiper
      container.classList.add('kd-gallery-loaded');
      container.classList.remove('kd-gallery-deferred');

      // Dynamically import Swiper only when needed (reduces initial JS bundle)
      if (!SwiperModule) {
        const module = await import('swiper');
        SwiperModule = module.default;
      }

      // Initialize Swiper for this container
      const swiperClass = `kd-swiper-${swiperIndex++}`;
      container.classList.add(swiperClass);

      new SwiperModule(`.${swiperClass}`, {
        slidesPerView: 4,
        spaceBetween: 10,
        slidesPerGroup: 1,
        watchSlidesProgress: true,
        loop: false
      });

    } catch (e) {
      console.error('Failed to parse gallery data:', e);
    }
  }

  function setupThumbnailClickHandlers() {
    // Use event delegation for better performance
    document.addEventListener('click', (e) => {
      const thumb = (e.target as Element).closest('.kd-thumb');
      if (!thumb) return;

      e.preventDefault();
      e.stopPropagation();

      const gallery = thumb.closest('.kd-product-gallery');
      const mainImg = gallery?.querySelector('.kd-main-img') as HTMLImageElement;
      const fullSrc = (thumb as HTMLImageElement).dataset.full;
      const container = thumb.closest('.kd-thumbnails');

      if (mainImg && fullSrc) {
        mainImg.src = fullSrc;
        // Update active state
        container?.querySelectorAll('.kd-thumb').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
      }
    });
  }

  function initIntersectionObserver() {
    // Only load gallery images when product card is near viewport
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const container = entry.target;
            loadGalleryImages(container);
            observer.unobserve(container); // Stop observing once loaded
          }
        });
      },
      {
        // Load when within 200px of viewport (preload slightly before visible)
        rootMargin: '200px 0px',
        threshold: 0
      }
    );

    // Observe all deferred gallery containers
    document.querySelectorAll('.kd-thumbnails.kd-gallery-deferred').forEach((container) => {
      observer.observe(container);
    });
  }

  // Set up click handlers immediately (event delegation)
  setupThumbnailClickHandlers();

  // Initialize IntersectionObserver after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIntersectionObserver);
  } else {
    // DOM already ready, use requestIdleCallback to not block main thread
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initIntersectionObserver, { timeout: 100 });
    } else {
      setTimeout(initIntersectionObserver, 0);
    }
  }
</script>
