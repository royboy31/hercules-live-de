---
// Was Kunden über uns sagen - Customer Reviews Section
// Uses TrustIndex widget for Google Reviews (same widget ID as WordPress)
// TrustIndex logo replaced with Google logo via JS
---

<section class="reviews-section" id="review-section">
  <div class="reviews-container">
    <h2 class="section-heading">
      Was Kunden <span class="highlight">über uns sagen</span>
    </h2>

    <!-- TrustIndex Widget - Same widget ID as WordPress -->
    <div class="reviews-widget" id="trustindex-widget"></div>
  </div>
</section>

<style>
  .reviews-section {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 0 50px 0;
  }

  .reviews-container {
    width: 100%;
  }

  .section-heading {
    font-family: 'Jost', sans-serif;
    font-size: 35px;
    font-weight: 600;
    text-transform: uppercase;
    color: #253461;
    text-align: center;
    margin: 0 0 55px 0;
  }

  .section-heading .highlight {
    color: #469ADC;
  }

  .reviews-widget {
    width: 100%;
    min-height: 300px;
  }

  /* Hide only TrustIndex branding link at bottom */
  :global(.ti-widget a[href*="trustindex"]),
  :global(.ti-widget a[title*="Trustindex"]),
  :global(.ti-widget a[title*="trustindex"]) {
    display: none !important;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .section-heading {
      font-size: 30px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .reviews-section {
      padding: 40px 20px;
    }

    .section-heading {
      font-size: 28px;
    }
  }
</style>

<script is:inline>
  // Load TrustIndex widget only when section becomes visible
  (function() {
    var loaded = false;
    function loadWidget() {
      if (loaded) return;
      loaded = true;
      var container = document.getElementById('trustindex-widget');
      if (container) {
        var script = document.createElement('script');
        script.src = 'https://cdn.trustindex.io/loader.js?72406ce58900366af2861a4ccab';
        script.defer = true;
        script.async = true;
        container.appendChild(script);

        // Watch for TrustIndex logo and replace instantly with MutationObserver
        var obs = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            m.addedNodes.forEach(function(node) {
              if (node.nodeType === 1) {
                var imgs = node.querySelectorAll ? node.querySelectorAll('img[src*="trustindex"]') : [];
                imgs.forEach(replaceLogo);
                if (node.tagName === 'IMG' && node.src && node.src.includes('trustindex')) {
                  replaceLogo(node);
                }
              }
            });
          });
        });
        obs.observe(container, { childList: true, subtree: true });
      }
    }

    function replaceLogo(img) {
      if (!img.src || !img.src.includes('logo')) return;
      img.style.visibility = 'hidden';
      img.style.width = '0';
      img.style.height = '0';
      img.style.position = 'absolute';
    }

    // Use IntersectionObserver to defer loading until visible
    var section = document.querySelector('.reviews-section');
    if (section && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          loadWidget();
          observer.disconnect();
        }
      }, { rootMargin: '200px 0px', threshold: 0 });
      observer.observe(section);
    } else {
      // Fallback for browsers without IntersectionObserver
      document.addEventListener('DOMContentLoaded', loadWidget);
    }
  })();
</script>
