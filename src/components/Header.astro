---
// Header component matching WordPress Elementor header exactly
// Container: 1280px, Logo: 70%, Icons: 22px/15px radius, Nav: 16px Jost
import MobileMenu from './MobileMenu.astro';
import ProductSearch from './ProductSearch.tsx';
import UserSession from './UserSession.tsx';
import ContactFormPopup from './ContactFormPopup.tsx';

// Sportarten menu items with icons
const sportarten = [
  { label: 'Fußball', href: '/collections/fussball/', icon: 'Football.svg' },
  { label: 'Rugby', href: '/collections/rugby/', icon: 'Rugby-1.svg' },
  { label: 'Basketball', href: '/collections/basketball/', icon: 'Basketball-1.svg' },
  { label: 'Laufen', href: '/collections/laufen/', icon: 'running-1.svg' },
  { label: 'Field hockey', href: '/collections/feldhockey/', icon: 'field-hockey-1.svg' },
  { label: 'Volleyball', href: '/collections/volleyball/', icon: 'volleyball-1.svg' },
  { label: 'Handball', href: '/collections/handball/', icon: 'handball-1.svg' },
  { label: 'Radfahren', href: '/collections/radfahren/', icon: 'cycling-1.svg' },
  { label: 'Fitness', href: '/collections/fitness/', icon: 'fitness-1.svg' },
  { label: 'Golf', href: '/collections/golf/', icon: 'golf-1.svg' },
  { label: 'eSports', href: '/collections/esport/', icon: 'esport-1.svg' },
];

// Produkte menu items with icons
const produkte = [
  { label: 'Sportbekleidung', href: '/collections/personalisierte-sportbekleidung/', icon: 'teamwear-1.svg' },
  { label: 'Schals', href: '/collections/personalisierte-fanschals/', icon: 'scarves-1.svg' },
  { label: 'Mützen', href: '/collections/personalisierte-mutzen/', icon: 'beanies-3.svg' },
  { label: 'Kopfbedeckung', href: '/collections/kopfbedeckung/', icon: 'cap-1.svg' },
  { label: 'Wimpel', href: '/collections/personalisierte-wimpel/', icon: 'pennants-3.svg' },
  { label: 'Handtücher', href: '/collections/handtucher/', icon: 'towelst-1.svg' },
  { label: 'Flaggen', href: '/collections/flaggen/', icon: 'flags-1.svg' },
  { label: 'Schuhwerk', href: '/collections/schuhwerk/', icon: 'footwear-1.svg' },
  { label: 'Taschen', href: '/collections/taschen/', icon: 'sportsbag-1.svg' },
  { label: 'Textilien', href: '/collections/personalisierte-textilien/', icon: 'textile-1.svg' },
  { label: 'Trinkgefäße', href: '/collections/trinkflaschen/', icon: 'drinkware-1.svg' },
  { label: 'Bälle', href: '/collections/balle/', icon: 'balls-1.svg' },
  { label: 'Zubehör', href: '/collections/zubehor/', icon: 'accessories-1.svg' },
];

// Themen menu items with icons
const themen = [
  { label: 'Sommer', href: '/collections/sommer/', icon: 'summer-1.svg' },
  { label: 'Winter', href: '/collections/winter/', icon: 'winter-1.svg' },
  { label: 'Nachhaltig', href: '/collections/nachhaltigkeit/', icon: 'sustainable-2.svg' },
  { label: 'Made in Europa', href: '/collections/hergestellt-in-europa/', icon: 'made-in-europe-1.svg' },
  { label: 'Mode', href: '/collections/mode/', icon: 'fashion-1.svg' },
  { label: 'Schulanfang', href: '/collections/schulanfang/', icon: 'back-to-school-1.svg' },
  { label: 'Tifo', href: '/collections/tifo/', icon: 'tifo-1.svg' },
  { label: 'Weihnachten', href: '/collections/weihnachten/', icon: 'christmas-1.svg' },
  { label: 'Kleine Preise', href: '/collections/kleine-preise/', icon: 'smallprices.svg' },
  { label: 'Geschäft', href: '/collections/business/', icon: 'business.svg' },
  { label: 'Werbegeschenke', href: '/collections/werbegeschenke/', icon: 'giive-aways.svg' },
  { label: 'Kinder', href: '/collections/kinder/', icon: 'kids.svg' },
];

// Direct navigation links
const directLinks = [
  { label: 'SPORTBEKLEIDUNG', href: '/collections/personalisierte-sportbekleidung/' },
  { label: 'SCHALS', href: '/collections/personalisierte-fanschals/' },
  { label: 'KOPFBEDECKUNG', href: '/collections/kopfbedeckung/' },
  { label: 'MÜTZEN', href: '/collections/personalisierte-mutzen/' },
];
---

<!-- Desktop Header -->
<header class="header" id="main-header">
  <!-- Main Header Row -->
  <div class="header-main">
    <div class="header-container">
      <!-- Logo - 282x126px original, displayed at 70% width -->
      <div class="header-logo-wrap">
        <a href="/" class="header-logo">
          <img
            src="/images/hercules-logo-original1.png"
            alt="Hercules Merchandise"
          />
        </a>
      </div>

      <!-- Search Bar - Full Width with React Component -->
      <div class="header-search">
        <ProductSearch client:load placeholder="Produkte suchen..." />
      </div>

      <!-- Header Icons -->
      <div class="header-icons">
        <UserSession client:load type="account" />

        <a href="/wishlist/" class="header-icon" aria-label="Wunschliste">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 27 27" fill="none">
            <path d="M18.7734 4.21875C16.5955 4.21875 14.6886 5.15531 13.5 6.7384C12.3114 5.15531 10.4045 4.21875 8.22656 4.21875C6.4929 4.2207 4.83079 4.91027 3.60491 6.13616C2.37902 7.36204 1.68945 9.02415 1.6875 10.7578C1.6875 18.1406 12.6341 24.1165 13.1003 24.3633C13.2231 24.4294 13.3605 24.464 13.5 24.464C13.6395 24.464 13.7769 24.4294 13.8997 24.3633C14.3659 24.1165 25.3125 18.1406 25.3125 10.7578C25.3105 9.02415 24.621 7.36204 23.3951 6.13616C22.1692 4.91027 20.5071 4.2207 18.7734 4.21875ZM13.5 22.6547C11.5741 21.5325 3.375 16.4204 3.375 10.7578C3.37667 9.47161 3.88836 8.23857 4.79784 7.32909C5.70732 6.41961 6.94036 5.90792 8.22656 5.90625C10.2779 5.90625 12.0002 6.99891 12.7195 8.75391C12.7831 8.90866 12.8912 9.04102 13.0302 9.13417C13.1692 9.22732 13.3327 9.27706 13.5 9.27706C13.6673 9.27706 13.8308 9.22732 13.9698 9.13417C14.1088 9.04102 14.2169 8.90866 14.2805 8.75391C14.9998 6.99574 16.7221 5.90625 18.7734 5.90625C20.0596 5.90792 21.2927 6.41961 22.2022 7.32909C23.1116 8.23857 23.6233 9.47161 23.625 10.7578C23.625 16.412 15.4237 21.5314 13.5 22.6547Z" fill="#253461"></path>
          </svg>
        </a>

        <UserSession client:load type="cart" />
      </div>
    </div>
  </div>

  <!-- Navigation Row -->
  <nav class="header-nav" aria-label="Hauptnavigation">
    <div class="nav-container">
      <div class="nav-menu">
        <!-- Dropdown Menus -->
        <div class="nav-item has-dropdown" data-menu="sportarten">
          <button class="nav-link">
            SPORTARTEN
            <svg class="nav-arrow" width="8" height="8" viewBox="0 0 320 512"><path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z" fill="currentColor"/></svg>
          </button>
          <div class="mega-menu">
            <div class="mega-menu-inner">
              <ul class="mega-menu-list with-icons">
                {sportarten.map((item) => (
                  <li>
                    <a href={item.href}>
                      <img src={`/images/menu/${item.icon}`} alt={`${item.label} Kategorie Icon`} width="24" height="24" />
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="nav-item has-dropdown" data-menu="produkte">
          <button class="nav-link">
            PRODUKTE
            <svg class="nav-arrow" width="8" height="8" viewBox="0 0 320 512"><path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z" fill="currentColor"/></svg>
          </button>
          <div class="mega-menu">
            <div class="mega-menu-inner">
              <ul class="mega-menu-list with-icons">
                {produkte.map((item) => (
                  <li>
                    <a href={item.href}>
                      <img src={`/images/menu/${item.icon}`} alt={`${item.label} Kategorie Icon`} width="24" height="24" />
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="nav-item has-dropdown" data-menu="themen">
          <button class="nav-link">
            THEMEN
            <svg class="nav-arrow" width="8" height="8" viewBox="0 0 320 512"><path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z" fill="currentColor"/></svg>
          </button>
          <div class="mega-menu">
            <div class="mega-menu-inner">
              <ul class="mega-menu-list with-icons">
                {themen.map((item) => (
                  <li>
                    <a href={item.href}>
                      <img src={`/images/menu/${item.icon}`} alt={`${item.label} Kollektion Icon`} width="24" height="24" />
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Direct Links -->
        {directLinks.map((link) => (
          <a href={link.href} class="nav-direct-link">{link.label}</a>
        ))}
      </div>

      <!-- Contact Button -->
      <ContactFormPopup client:load triggerType="button" triggerText="KONTAKT" triggerClassName="nav-cta-popup" />
    </div>
  </nav>
</header>

<!-- Mobile Header -->
<header class="mobile-header" id="mobile-header">
  <!-- Top Bar - Google Reviews (Dark Blue Background) -->
  <div class="mobile-topbar">
    <div class="mobile-topbar-reviews">
      <a href="#review-section">
        <img src="/images/google-reviews.png" alt="Google Bewertungen 4.9 Sterne" />
      </a>
    </div>
  </div>

  <!-- Logo & Icons Row -->
  <div class="mobile-header-inner">
    <div class="mobile-logo-wrap">
      <a href="/" class="mobile-logo">
        <img src="/images/hercules-logo-mobile.png" alt="Hercules Merchandise" />
      </a>
    </div>
    <div class="mobile-actions">
      <button class="mobile-btn mobile-search-btn" aria-label="Suchen" id="mobile-search-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
          <path d="M21.3248 20.1752L16.2396 15.0909C17.7135 13.3214 18.4485 11.0518 18.2916 8.75419C18.1347 6.45658 17.0981 4.3079 15.3974 2.75513C13.6967 1.20236 11.4628 0.365042 9.16039 0.417367C6.85803 0.469692 4.66448 1.40763 3.03605 3.03606C1.40761 4.6645 0.469677 6.85805 0.417352 9.16041C0.365027 11.4628 1.20234 13.6967 2.75512 15.3974C4.30789 17.0981 6.45657 18.1348 8.75417 18.2916C11.0518 18.4485 13.3214 17.7135 15.0909 16.2396L20.1751 21.3249C20.2506 21.4003 20.3403 21.4602 20.4389 21.5011C20.5375 21.5419 20.6432 21.563 20.75 21.563C20.8567 21.563 20.9625 21.5419 21.0611 21.5011C21.1597 21.4602 21.2493 21.4003 21.3248 21.3249C21.4003 21.2494 21.4602 21.1597 21.5011 21.0611C21.5419 20.9625 21.5629 20.8568 21.5629 20.75C21.5629 20.6432 21.5419 20.5375 21.5011 20.4389C21.4602 20.3403 21.4003 20.2507 21.3248 20.1752ZM2.06249 9.375C2.06249 7.92873 2.49136 6.51493 3.29487 5.3124C4.09837 4.10986 5.24043 3.1726 6.57662 2.61913C7.9128 2.06567 9.3831 1.92086 10.8016 2.20301C12.2201 2.48517 13.523 3.18161 14.5457 4.20428C15.5684 5.22696 16.2648 6.52992 16.547 7.94841C16.8291 9.36689 16.6843 10.8372 16.1309 12.1734C15.5774 13.5096 14.6401 14.6516 13.4376 15.4551C12.2351 16.2586 10.8213 16.6875 9.37499 16.6875C7.43625 16.6854 5.57754 15.9142 4.20664 14.5433C2.83575 13.1725 2.06464 11.3137 2.06249 9.375Z" fill="#253461"></path>
        </svg>
      </button>
      <ContactFormPopup client:load triggerType="icon" triggerClassName="mobile-contact-popup" />
      <button class="mobile-hamburger" id="mobile-menu-toggle" aria-label="Menu">
        &#9776;
      </button>
    </div>
  </div>
</header>

<!-- Mobile Search Overlay -->
<div class="mobile-search-overlay" id="mobile-search-overlay">
  <div class="mobile-search-container">
    <button class="mobile-search-close" id="mobile-search-close" aria-label="Schließen">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <ProductSearch client:load placeholder="Produkte suchen..." />
  </div>
</div>

<MobileMenu />

<style>
  /* Desktop Header - EXACT WordPress Elementor CSS */
  .header {
    display: none;
    background: #fff;
    position: relative;
    z-index: 100;
    font-family: 'Jost', sans-serif;
  }

  @media (min-width: 769px) {
    .header {
      display: block;
    }
  }

  /* Main Header Row - elementor-element-f7f2fa7 */
  .header-main {
    background: #fff;
    padding: 5px 0;
  }

  .header-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: space-around;
  }

  /* Logo wrapper - elementor-element-222f227 */
  .header-logo-wrap {
    flex-shrink: 0;
    padding: 10px 10px 10px 0;
  }

  .header-logo {
    display: block;
  }

  /* Logo - 172px width */
  .header-logo img {
    width: 172px;
    height: auto;
    display: block;
  }

  /* Search - 708px width, 144px gap from logo */
  .header-search {
    width: 708px;
    flex-shrink: 0;
    margin-left: 144px;
  }

  /* Override ProductSearch component styles to match header */
  .header-search :global(.product-search-input) {
    height: 44px;
    padding: 12px 45px 12px 18px;
    font-size: 14px;
    border: 1px solid #bfbfbf;
    border-radius: 15px;
  }

  .header-search :global(.product-search-input::placeholder) {
    color: #888;
  }

  /* Header Icons - right aligned */
  .header-icons {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    flex-shrink: 0;
    padding: 0 0 4px 0;
    margin-left: auto;
  }

  /* Icon buttons - elementor-element-5bdc66d, dd73c14, d8c5621 */
  .header-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid #253461;
    border-radius: 15px;
    color: #253461;
    background: transparent;
    transition: all 0.3s;
  }

  .header-icon svg {
    width: 22px;
    height: 22px;
  }

  .header-icon:hover {
    border-color: #469ADC;
  }

  .header-icon:hover svg path {
    fill: #469ADC;
  }

  /* Cart count badge */
  .cart-icon {
    position: relative;
  }

  .cart-icon :global(.cart-count-badge) {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #10C99E;
    color: white;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Jost', sans-serif;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }


  /* Navigation - elementor-element-93ee650 */
  .header-nav {
    background: #fff;
    border-top: 1px solid #FAFAFA;
    box-shadow: 0px 9px 10px 0px rgba(0, 0, 0, 0.05);
    padding-bottom: 3px;
  }

  .nav-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  /* Navigation links with dropdown - 44px gap */
  .nav-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 14px 22px;
    background: none;
    border: none;
    font-family: 'Jost', Sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    color: #00aeef;
    cursor: pointer;
    transition: color 0.3s;
  }

  .nav-link:hover {
    color: #469ADC;
  }

  .nav-arrow {
    transition: transform 0.2s;
    opacity: 0.7;
  }

  .nav-item:hover .nav-arrow {
    transform: rotate(180deg);
  }

  .nav-direct-link {
    display: flex;
    align-items: center;
    padding: 14px 25px;
    font-family: 'Jost', Sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    color: #253461;
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-direct-link:hover {
    color: #469ADC;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 10px 28px;
    background: #10C99E;
    color: white;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border-radius: 50px;
    transition: background 0.2s;
  }

  .nav-cta:hover {
    background: #0eb58d;
  }

  /* Contact Popup Trigger - Desktop */
  .nav-cta-popup :global(.contact-trigger-button) {
    display: inline-flex;
    align-items: center;
    padding: 10px 28px;
    background: #10C99E;
    color: white;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .nav-cta-popup :global(.contact-trigger-button:hover) {
    background: #0eb58d;
  }

  /* Mega Menu - matching WordPress Elementor styling */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    border-top: 1px solid #FAFAFA;
    box-shadow: 0px 23px 4px -21px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    z-index: 100;
  }

  .nav-item:hover .mega-menu {
    opacity: 1;
    visibility: visible;
  }

  .mega-menu-inner {
    padding: 10px 0;
  }

  .mega-menu-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 780px;
  }

  .mega-menu-list.with-icons {
    grid-template-columns: repeat(4, 1fr);
    min-width: 780px;
  }

  .mega-menu-list li a {
    display: flex;
    align-items: center;
    gap: 0;
    height: 39px;
    padding: 0 15px;
    color: #253461;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.3s, background-color 0.3s;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .mega-menu-list li a:hover {
    background: #F5F5F5;
    color: #469ADC;
  }

  .mega-menu-list li a img {
    width: 17px;
    height: 17px;
    object-fit: contain;
    margin-right: calc(17px * 0.25);
  }

  /* Mobile Header - Exact Elementor Styles */
  .mobile-header {
    display: block;
    background: #FFFFFF;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  @media (min-width: 769px) {
    .mobile-header {
      display: none;
    }
  }

  /* Top Bar - Dark Blue Background (#253461) */
  .mobile-topbar {
    background-color: #253461;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
  }

  .mobile-topbar-reviews {
    width: 35%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 6px;
    padding-top: 6px;
  }

  .mobile-topbar-reviews a {
    display: inline-block;
  }

  .mobile-topbar-reviews img {
    max-width: 100%;
    height: auto;
  }

  /* Logo & Icons Row */
  .mobile-header-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background: #FFFFFF;
  }

  .mobile-logo-wrap {
    width: 40%;
    display: flex;
    align-items: center;
  }

  .mobile-logo img {
    width: 100%;
    height: auto;
    max-width: 140px;
  }

  .mobile-actions {
    width: 60%;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }

  /* Search Button - White bg, dark blue border */
  .mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 5px;
    padding: 13px;
    transition: all 0.2s;
  }

  .mobile-search-btn {
    background-color: #FFFFFF;
    color: #253461;
    fill: #253461;
    border: 1px solid #253461;
  }

  .mobile-search-btn:hover,
  .mobile-search-btn:focus {
    background-color: #FFFFFF;
    color: #253461;
    border-color: #253461;
  }

  .mobile-search-btn svg {
    width: 22px;
    height: 22px;
  }

  /* Contact/Mail Button - Green bg */
  .mobile-contact-btn {
