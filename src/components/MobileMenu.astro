---
// Mobile slide-out menu with two-panel side-by-side layout
// Matches the design: Left panel (categories), Right panel (submenu with icons)

// Menu items with icons
const mobileMenuItems = {
  sportarten: {
    title: 'Sportarten',
    titleEn: 'SPORTS',
    items: [
      { label: 'Fußball', href: '/kollektionen/fussball/', icon: 'Football.svg' },
      { label: 'Rugby', href: '/kollektionen/rugby/', icon: 'Rugby-1.svg' },
      { label: 'Basketball', href: '/kollektionen/basketball/', icon: 'Basketball-1.svg' },
      { label: 'Laufen', href: '/kollektionen/laufen/', icon: 'running-1.svg' },
      { label: 'Field hockey', href: '/kollektionen/feldhockey/', icon: 'field-hockey-1.svg' },
      { label: 'Volleyball', href: '/kollektionen/volleyball/', icon: 'volleyball-1.svg' },
      { label: 'Handball', href: '/kollektionen/handball/', icon: 'handball-1.svg' },
      { label: 'Radfahren', href: '/kollektionen/radfahren/', icon: 'cycling-1.svg' },
      { label: 'Fitness', href: '/kollektionen/fitness/', icon: 'fitness-1.svg' },
      { label: 'Golf', href: '/kollektionen/golf/', icon: 'golf-1.svg' },
      { label: 'eSports', href: '/kollektionen/esport/', icon: 'esport-1.svg' },
    ]
  },
  produkte: {
    title: 'Produkte',
    titleEn: 'PRODUCTS',
    items: [
      { label: 'Sportswear', href: '/kollektionen/personalisierte-sportbekleidung/', icon: 'teamwear-1.svg' },
      { label: 'Schals', href: '/kollektionen/personalisierte-fanschals/', icon: 'scarves-1.svg' },
      { label: 'Mützen', href: '/kollektionen/personalisierte-mutzen/', icon: 'beanies-3.svg' },
      { label: 'Kopfbedeckung', href: '/kollektionen/kopfbedeckung/', icon: 'cap-1.svg' },
      { label: 'Wimpel', href: '/kollektionen/personalisierte-wimpel/', icon: 'pennants-3.svg' },
      { label: 'Handtücher', href: '/kollektionen/handtucher/', icon: 'towelst-1.svg' },
      { label: 'Flaggen', href: '/kollektionen/flaggen/', icon: 'flags-1.svg' },
      { label: 'Schuhwerk', href: '/kollektionen/schuhwerk/', icon: 'footwear-1.svg' },
      { label: 'Taschen', href: '/kollektionen/taschen/', icon: 'sportsbag-1.svg' },
      { label: 'Textile', href: '/kollektionen/personalisierte-textilien/', icon: 'textile-1.svg' },
      { label: 'Trinkflaschen', href: '/kollektionen/trinkflaschen/', icon: 'drinkware-1.svg' },
      { label: 'Bälle', href: '/kollektionen/balle/', icon: 'balls-1.svg' },
      { label: 'Zubehör', href: '/kollektionen/zubehor/', icon: 'accessories-1.svg' },
    ]
  },
  themen: {
    title: 'Themen',
    titleEn: 'THEMES',
    items: [
      { label: 'Sommer', href: '/kollektionen/sommer/', icon: 'summer-1.svg' },
      { label: 'Winter', href: '/kollektionen/winter/', icon: 'winter-1.svg' },
      { label: 'Nachhaltigkeit', href: '/kollektionen/nachhaltigkeit/', icon: 'sustainable-2.svg' },
      { label: 'Hergestellt in Europa', href: '/kollektionen/hergestellt-in-europa/', icon: 'made-in-europe-1.svg' },
      { label: 'Mode', href: '/kollektionen/mode/', icon: 'fashion-1.svg' },
      { label: 'Schulanfang', href: '/kollektionen/schulanfang/', icon: 'back-to-school-1.svg' },
      { label: 'Tifo', href: '/kollektionen/tifo/', icon: 'tifo-1.svg' },
      { label: 'Weihnachten', href: '/kollektionen/weihnachten/', icon: 'christmas-1.svg' },
      { label: 'Kleine Preise', href: '/kollektionen/kleine-preise/', icon: 'smallprices.svg' },
      { label: 'Business', href: '/kollektionen/business/', icon: 'business.svg' },
      { label: 'Werbegeschenke', href: '/kollektionen/werbegeschenke/', icon: 'giive-aways.svg' },
      { label: 'Kinder', href: '/kollektionen/kinder/', icon: 'kids.svg' },
    ]
  },
};
---

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu">
  <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>

  <div class="mobile-menu-panel">
    <!-- Top Bar with Search -->
    <div class="mobile-top-bar">
      <button id="mobile-menu-close" class="top-bar-btn hamburger-btn" aria-label="Menu schließen">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <div class="mobile-search-wrapper">
        <input type="text" placeholder="Search products..." class="mobile-search-input" id="mobile-search-input" />
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
      </div>

      <button class="top-bar-btn contact-btn" id="mobile-contact-btn" aria-label="Kontakt">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </button>
    </div>

    <!-- Logo Section -->
    <div class="mobile-logo-section">
      <a href="/">
        <img
          src="/images/hercules-logo-original1.webp"
          alt="Hercules Merchandise"
          class="mobile-menu-logo"
          width="176"
          height="78"
        />
      </a>
    </div>

    <!-- Two-Panel Layout -->
    <div class="panels-container">
      <!-- Left Panel: Main Categories -->
      <div class="left-panel">
        {Object.entries(mobileMenuItems).map(([key, menu], index) => (
          <button
            class={`category-btn ${index === 0 ? 'active' : ''}`}
            data-category={key}
          >
            <span class="category-label">{menu.title.toUpperCase()}</span>
            <svg class="category-arrow" width="8" height="12" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1.5 1L6.5 6L1.5 11"/>
            </svg>
          </button>
        ))}
      </div>

      <!-- Right Panel: Submenu Items -->
      <div class="right-panel">
        {Object.entries(mobileMenuItems).map(([key, menu], index) => (
          <div class={`submenu-panel ${index === 0 ? 'active' : ''}`} data-submenu={key}>
            <div class="submenu-title">{menu.title.toUpperCase()}</div>
            <div class="submenu-grid">
              {menu.items.map((item) => (
                <a href={item.href} class="submenu-item">
                  <img
                    src={`/images/menu/${item.icon}`}
                    alt=""
                    class="submenu-icon"
                    width="24"
                    height="24"
                  />
                  <span class="submenu-label">{item.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Links -->
    <div class="mobile-bottom-links">
      <a href="/wishlist/" class="bottom-link">
        <svg class="bottom-link-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>Wunschliste</span>
      </a>
      <a href="/kontaktieren-sie-uns" class="bottom-link cta-link">
        <span>Kontakt</span>
      </a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    pointer-events: none;
  }

  body.mobile-menu-open .mobile-menu {
    pointer-events: auto;
  }

  .mobile-menu-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s;
  }

  body.mobile-menu-open .mobile-menu-overlay {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background: white;
    transform: translateX(-100%);
    transition: transform 0.3s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  body.mobile-menu-open .mobile-menu-panel {
    transform: translateX(0);
  }

  /* Top Bar */
  .mobile-top-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    background: #F4F4F4;
  }

  .top-bar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .hamburger-btn {
    background: #253461;
    color: white;
  }

  .contact-btn {
    background: #10C99E;
    color: white;
  }

  .mobile-search-wrapper {
    flex: 1;
    position: relative;
  }

  .mobile-search-input {
    width: 100%;
    height: 44px;
    padding: 0 40px 0 15px;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    background: white;
  }

  .mobile-search-input::placeholder {
    color: #9CA3AF;
  }

  .mobile-search-wrapper .search-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #253461;
    pointer-events: none;
  }

  /* Logo Section */
  .mobile-logo-section {
    padding: 15px 20px;
    border-bottom: 1px solid #E5E7EB;
  }

  .mobile-menu-logo {
    height: 50px;
    width: auto;
  }

  /* Two-Panel Layout */
  .panels-container {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* Left Panel */
  .left-panel {
    width: 140px;
    flex-shrink: 0;
    background: #FAFAFA;
    border-right: 1px solid #E5E7EB;
    display: flex;
    flex-direction: column;
    padding: 10px 0;
  }

  .category-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 18px 15px;
    background: none;
    border: none;
    border-left: 3px solid transparent;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #253461;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
  }

  .category-btn:hover {
    background: #F0F0F0;
  }

  .category-btn.active {
    background: white;
    border-left-color: #253461;
  }

  .category-label {
    flex: 1;
  }

  .category-arrow {
    color: #253461;
    flex-shrink: 0;
  }

  /* Right Panel */
  .right-panel {
    flex: 1;
    overflow-y: auto;
    background: white;
  }

  .submenu-panel {
    display: none;
    padding: 20px;
  }

  .submenu-panel.active {
    display: block;
  }

  .submenu-title {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #253461;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid #E5E7EB;
  }

  .submenu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 15px;
  }

  .submenu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 8px;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s;
  }

  .submenu-item:hover {
    background: #F5F5F5;
  }

  .submenu-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .submenu-label {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #253461;
    line-height: 1.3;
  }

  .submenu-item:hover .submenu-label {
    color: #469ADC;
  }

  /* Bottom Links */
  .mobile-bottom-links {
    display: flex;
    gap: 15px;
    padding: 15px 20px;
    border-top: 1px solid #E5E7EB;
    background: white;
  }

  .bottom-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #253461;
    text-decoration: none;
    border: 1px solid #E5E7EB;
    border-radius: 50px;
    transition: all 0.2s;
  }

  .bottom-link:hover {
    border-color: #253461;
  }

  .bottom-link-icon {
    color: #10C99E;
  }

  .cta-link {
    background: #10C99E;
    color: white;
    border-color: #10C99E;
    flex: 1;
    justify-content: center;
  }

  .cta-link:hover {
    background: #0eb58d;
    border-color: #0eb58d;
  }

  /* Responsive adjustments for very small screens */
  @media (max-width: 360px) {
    .left-panel {
      width: 120px;
    }

    .category-btn {
      padding: 15px 10px;
      font-size: 13px;
    }

    .submenu-grid {
      grid-template-columns: 1fr;
    }

    .submenu-item {
      padding: 10px 5px;
    }
  }
</style>

<script>
  // Mobile menu controls
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileContactBtn = document.getElementById('mobile-contact-btn');

  // Category switching
  const categoryBtns = document.querySelectorAll('.category-btn');
  const submenuPanels = document.querySelectorAll('.submenu-panel');

  // Open menu
  mobileMenuToggle?.addEventListener('click', () => {
    document.body.classList.add('mobile-menu-open');
  });

  // Close menu function
  function closeMenu() {
    document.body.classList.remove('mobile-menu-open');
  }

  // Close menu buttons
  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuOverlay?.addEventListener('click', closeMenu);

  // Category switching (show corresponding submenu)
  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      // Update active category button
      categoryBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Show corresponding submenu panel
      submenuPanels.forEach(panel => {
        if (panel.getAttribute('data-submenu') === category) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    });
  });

  // Contact button - open contact form popup if available
  mobileContactBtn?.addEventListener('click', () => {
    // Try to trigger the contact form popup
    const contactFormTrigger = document.querySelector('[data-contact-popup-trigger]');
    if (contactFormTrigger) {
      contactFormTrigger.click();
    } else {
      // Fallback: navigate to contact page
      window.location.href = '/kontaktieren-sie-uns';
    }
    closeMenu();
  });

  // Close menu on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });

  // Mobile search functionality
  const mobileSearchInput = document.getElementById('mobile-search-input');
  mobileSearchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const query = mobileSearchInput.value.trim();
      if (query) {
        window.location.href = `/?s=${encodeURIComponent(query)}`;
      }
    }
  });
</script>
