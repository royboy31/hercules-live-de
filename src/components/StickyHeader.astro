const produkte = [
  { label: 'Sportswear', href: '/collections/personalisierte-sportbekleidung/', icon: 'teamwear-1.svg' },
  { label: 'Schals', href: '/collections/personalisierte-fanschals/', icon: 'scarves-1.svg' },
