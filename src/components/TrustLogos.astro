---

<section class="trust-section">
  <div class="trust-container">
    <h2 class="section-heading">Sie vertrauen uns</h2>

    <!-- Row 1: Left to Right -->
    <div class="swiper trust-swiper-ltr">
      <div class="swiper-wrapper">
        {logosRow1.map((logo) => (
          <div class="swiper-slide">
            <figure class="logo-figure">
              <img src={logo.src} alt={logo.alt} loading="lazy" />
            </figure>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Right to Left -->
    <div class="swiper trust-swiper-rtl" dir="rtl">
      <div class="swiper-wrapper">
        {logosRow2.map((logo) => (
          <div class="swiper-slide">
            <figure class="logo-figure">
              <img src={logo.src} alt={logo.alt} loading="lazy" />
            </figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css" />

<style>
  .trust-section {
    background-color: #F4F4F4;
    padding: 30px 0;
    overflow: hidden;
    width: 100%;
  }

  .trust-container {
    width: 100%;
  }

  .section-heading {
    font-family: 'Jost', sans-serif;
    font-size: 35px;
    font-weight: 600;
    text-transform: uppercase;
    color: #253461;
    text-align: center;
    margin: 0 0 20px 0;
    padding: 0 20px;
  }

  .swiper {
    width: 100%;
    padding: 10px 0;
  }

  .swiper-slide {
    width: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-figure {
    margin: 0;
    padding: 0;
    line-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-figure img {
    width: 218.13px;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .logo-figure img:hover {
    transform: scale(1.05);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .logo-figure img {
      width: 180px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .section-heading {
      font-size: 28px;
    }

    .logo-figure img {
      width: 140px;
    }
  }
</style>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Common Swiper settings matching WordPress Elementor
    const swiperSettings = {
      slidesPerView: 8,
      spaceBetween: 20,
      loop: true,
      speed: 9000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      allowTouchMove: true,
      breakpoints: {
        0: {
          slidesPerView: 2,
          spaceBetween: 20,
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 20,
        },
        1025: {
          slidesPerView: 8,
          spaceBetween: 20,
        },
      },
    };

    // Initialize LTR carousel
    const swiperLtr = new Swiper('.trust-swiper-ltr', {
      ...swiperSettings,
    });

    // Initialize RTL carousel
    const swiperRtl = new Swiper('.trust-swiper-rtl', {
      ...swiperSettings,
    });

    // Force linear timing for continuous scroll
    const style = document.createElement('style');
    style.textContent = `
      .trust-swiper-ltr .swiper-wrapper,
      .trust-swiper-rtl .swiper-wrapper {
        transition-timing-function: linear !important;
      }
    `;
    document.head.appendChild(style);
  });
</script>
